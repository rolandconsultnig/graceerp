{
  "name": "graceerp",
  "version": "1.0.0",
  "description": "GraceERP — Full-Stack Church Enterprise Resource Planning Platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "migrate": "npm run migrate --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "setup": "npm install && npm run migrate && npm run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
