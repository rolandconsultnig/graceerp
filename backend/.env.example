# GraceERP Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=2020

# ── PostgreSQL Database ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=graceerp
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:2025

# ── Portal chat WebRTC ─────────────────────────────────────────────────────────
# RESTART the API (Node) after changing STUN/TURN, WEBRTC_ICE_SERVERS_JSON, or ring timeout vars — they are
# read at process start. Clients get new values from GET /api/member-portal/chat/webrtc-config on the next
# request (e.g. refresh the app or re-open the chat tab after you restart the server).
#
# Simple STUN-only list (comma-separated). Enough for many LAN/dev tests; symmetric NAT often needs TURN.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
#
# Ring durations for portal voice/video (milliseconds, clamped 10s–300s server-side).
PORTAL_CHAT_OUTGOING_RING_MS=55000
PORTAL_CHAT_INCOMING_RING_MS=75000
#
# Optional: full iceServers JSON (used instead of WEBRTC_STUN_URLS when valid JSON array).
# Use this when you run Coturn or another TURN server that needs username/credential.
# Example single Coturn relay (replace host/user/pass; use turns:3478 behind TLS terminator):
# WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"graceerp","credential":"long-shared-secret"}]
#
# Hosting checklist:
# - Open UDP (and TCP if using tcp relay) on your TURN ports (often 3478; TLS commonly 5349).
# - Point DNS A/AAAA at the machine running Coturn; for HTTPS sites prefer TLS/TURNS on 5349.
# - Docker: image coturn/coturn, mount turnserver.conf with realm, user=password static-auth-secret or lt-cred-mech.
# - After changing any WebRTC/ring env above, restart the API so /member-portal/chat/webrtc-config returns the new data.

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
